# WhatsApp is disabled until all settings are present and a template is approved.
WHATSAPP_SEND_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Template and language are selected in /admin from the approved catalog in Postgres.
# Explicitly choose a currently supported Graph API version before activation.
WHATSAPP_GRAPH_API_VERSION=

# Follow-up Edge Function: Supabase provides SUPABASE_URL and SUPABASE_SECRET_KEYS.
FOLLOWUP_EMAIL_SEND_ENABLED=false
FOLLOWUP_WHATSAPP_SEND_ENABLED=false
FOLLOWUP_WHATSAPP_TEST_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
ADMIN_SITE_URL=https://TU-DOMINIO
# Must match EMAIL_UNSUBSCRIBE_SECRET in Next.js, which handles unsubscribe links.
EMAIL_UNSUBSCRIBE_SECRET=

# Private, manually invoked connection test using Meta's sandbox number.
# These credentials are independent of the automatic follow-up channel above.
WHATSAPP_TEST_ACCESS_TOKEN=
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_GRAPH_API_VERSION=
# One recipient already verified in Meta's test dashboard, in E.164 format.
WHATSAPP_TEST_RECIPIENT=
