# Server-only Next.js settings. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Optional override; defaults to the Apps Script endpoint in reference/template.html.
GOOGLE_SHEETS_ENDPOINT=
# Only the local HTTP preview helper sets ADMIN_LOCAL_HTTP=true. Leave unset in production.
# Optional: server-only Vercel Analytics connection for /admin.
VERCEL_ANALYTICS_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
VERCEL_ANALYTICS_TEAM_ID=
ADMIN_SITE_URL=https://TU-DOMINIO
# Generate at least 32 random characters; do not use this example as a secret.
LEAD_IP_HMAC_SECRET=

# Cal.com event-type webhook, using the default nested payload (no custom template).
CAL_WEBHOOK_SECRET=
CAL_EVENT_SLUG=sesion-gratuita-comunicacion
# Incoming WhatsApp messages / CONFIRMO / BAJA. Server-side secrets only.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Keep this identical to the Edge Function secret so existing unsubscribe links work.
EMAIL_UNSUBSCRIBE_SECRET=
# JSON mapping of step keys to approved Meta names; used by the sync script.
FOLLOWUP_WHATSAPP_TEMPLATES=
